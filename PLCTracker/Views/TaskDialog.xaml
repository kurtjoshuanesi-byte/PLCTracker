<Window x:Class="PLCTracker.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#0F111A" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Client:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="ClientCombo" DisplayMemberPath="Name" Margin="0,0,0,15" Padding="8" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748"/>

            <TextBlock Text="Task Type:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="TypeCombo" Margin="0,0,0,15" Padding="8" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748">
                <ComboBoxItem Content="📞 Callback"/>
                <ComboBoxItem Content="🔁 Follow-up"/>
                <ComboBoxItem Content="📋 Pre-Onboarding"/>
                <ComboBoxItem Content="📌 Custom"/>
            </ComboBox>

            <TextBlock Text="Due Date &amp; Time:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <DatePicker Grid.Column="0" x:Name="DueDatePicker" Padding="5" Background="#1A1D27"/>
                <TextBlock Grid.Column="1" Text="Time:" VerticalAlignment="Center" Margin="10,0"/>
                <TextBox Grid.Column="2" x:Name="DueTimeBox" Text="09:00" TextAlignment="Center" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748" Padding="8" CaretBrush="White"/>
            </Grid>

            <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="NotesBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748" Padding="8" CaretBrush="White"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Save Task" Click="Save_Click" 
                Background="#7B61FF" Foreground="White" FontWeight="Bold" 
                Padding="15,10" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>