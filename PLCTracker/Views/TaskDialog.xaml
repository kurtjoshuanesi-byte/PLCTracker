<Window x:Class="PLCTracker.Views.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details" Height="470" Width="480" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock Text="Client:*" FontWeight="Bold"/>
        <ComboBox x:Name="ClientCombo" DisplayMemberPath="Name" Margin="0,4,0,10"/>

        <TextBlock Text="Task Type:*" FontWeight="Bold"/>
        <ComboBox x:Name="TypeCombo" Margin="0,4,0,10">
            <ComboBoxItem Content="📞 Callback"/>
            <ComboBoxItem Content="🔁 Follow-up"/>
            <ComboBoxItem Content="📋 Pre-Onboarding"/>
            <ComboBoxItem Content="📌 Custom"/>
        </ComboBox>

        <TextBlock Text="Due Date &amp; Time:*" FontWeight="Bold"/>
        <DatePicker x:Name="DueDatePicker" Margin="0,4,0,4"/>
        <TextBox x:Name="DueTimeBox" Text="09:00" Margin="0,0,0,10"/>

        <TextBlock Text="Notes:" FontWeight="Bold"/>
        <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <Button Content="Save Task" Click="Save_Click" Padding="10,8"
                Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
    </StackPanel>
</Window>