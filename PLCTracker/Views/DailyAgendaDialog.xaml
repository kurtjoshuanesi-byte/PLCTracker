<Window x:Class="PLCTracker.Views.DailyAgendaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Agenda" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" 
        Background="#121316" Foreground="#E0E0E0" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🌅 Good Morning!" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" x:Name="SummaryText" FontSize="14" Foreground="#8B92A5" Margin="0,0,0,15"/>

        <ListBox Grid.Row="2" x:Name="AgendaList" Background="#1A1C23" BorderBrush="#2C303A" BorderThickness="1" Padding="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding TimeString}" Width="80" FontWeight="Bold" Foreground="#FF5C00"/>
                        <TextBlock Text="{Binding TypeLabel}" Width="130" Foreground="#8B92A5"/>
                        <TextBlock Text="{Binding ClientName}" Width="150" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding Notes}" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Content="Let's Go! 🚀" Click="Close_Click" 
                Margin="0,15,0,0" Height="35" Background="#FF5C00" Foreground="White" 
                FontWeight="Bold" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="3"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>