<Window x:Class="PLCTracker.Views.ClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Details" Height="480" Width="450" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock Text="Name:*" FontWeight="Bold"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,10"/>

        <TextBlock Text="Phone:" FontWeight="Bold"/>
        <TextBox x:Name="PhoneBox" Margin="0,4,0,10"/>

        <TextBlock Text="Email:" FontWeight="Bold"/>
        <TextBox x:Name="EmailBox" Margin="0,4,0,10"/>

        <TextBlock Text="Status:" FontWeight="Bold"/>
        <ComboBox x:Name="StatusCombo" Margin="0,4,0,10">
            <ComboBoxItem Content="Pending"/>
            <ComboBoxItem Content="Scheduled"/>
            <ComboBoxItem Content="Onboarded"/>
            <ComboBoxItem Content="Dropped"/>
        </ComboBox>

        <TextBlock Text="Notes:" FontWeight="Bold"/>
        <TextBox x:Name="NotesBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,10"/>

        <Button Content="Save Client" Click="Save_Click" Padding="10,8"
                Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
    </StackPanel>
</Window>