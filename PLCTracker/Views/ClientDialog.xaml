<Window x:Class="PLCTracker.Views.ClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Details" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#0F111A" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Name:*" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,15" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748" Padding="8" CaretBrush="White"/>

            <TextBlock Text="Phone:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="PhoneBox" Margin="0,0,0,15" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748" Padding="8" CaretBrush="White"/>

            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Margin="0,0,0,15" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748" Padding="8" CaretBrush="White"/>

            <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="StatusCombo" Margin="0,0,0,15" Padding="8" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748">
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Scheduled"/>
                <ComboBoxItem Content="Onboarded"/>
                <ComboBoxItem Content="Dropped"/>
            </ComboBox>

            <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="NotesBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" Background="#1A1D27" Foreground="White" BorderBrush="#2D3748" Padding="8" CaretBrush="White"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Save Client" Click="Save_Click" 
                Background="#7B61FF" Foreground="White" FontWeight="Bold" 
                Padding="15,10" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>