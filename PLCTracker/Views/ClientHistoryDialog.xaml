<Window x:Class="PLCTracker.Views.ClientHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client History" Height="500" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="130"/>
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat='MMM dd, yyyy hh:mm tt'}" Width="160"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>