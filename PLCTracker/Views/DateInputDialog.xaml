<Window x:Class="PLCTracker.Views.DateInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Date" Height="250" Width="400" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15">
        <TextBlock x:Name="PromptText" FontWeight="Bold" Margin="0,0,0,10"/>
        <DatePicker x:Name="DatePickerControl" Margin="0,0,0,15"/>
        <Button Content="OK" Click="Ok_Click" Padding="10,6"
                Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
    </StackPanel>
</Window>