<Window x:Class="PLCTracker.Views.DateInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Date" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0F111A" Foreground="#E2E8F0" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="PromptText" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap"/>
            <DatePicker x:Name="DatePickerControl" Margin="0,0,0,20" Padding="5" Background="#1A1D27"/>
        </StackPanel>

        <Button Grid.Row="2" Content="OK" Click="Ok_Click" 
                Background="#7B61FF" Foreground="White" FontWeight="Bold" 
                Padding="15,10" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>