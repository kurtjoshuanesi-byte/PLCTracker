<ui:FluentWindow x:Class="PLCTracker.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="PLC Intake Tracker" Height="800" Width="1200"
                 Icon="pack://application:,,,/app.ico"
                 WindowStartupLocation="CenterScreen" 
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KINI ANG SAKTONG TITLE BAR NGA NAAY ICON -->
        <ui:TitleBar Grid.Row="0" Title="PLC Intake Tracker" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- (Ang ubang Grid code nimo sa ubos, wala nay usbon) -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CUSTOM SIDEBAR -->
            <Border Grid.Column="0" Background="#1A1D27" BorderBrush="#2D3748" BorderThickness="0,0,1,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="MAIN MENU" Foreground="#94A3B8" Margin="10,10,10,5" FontSize="11" FontWeight="Bold"/>

                    <ui:Button x:Name="BtnTasks" Content="Tasks" Icon="{ui:SymbolIcon TaskListLtr24}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnTasks_Click" Margin="0,0,0,5"/>
                    <ui:Button x:Name="BtnClients" Content="Clients" Icon="{ui:SymbolIcon People24}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BtnClients_Click" Margin="0,0,0,5"/>

                    <TextBlock Text="SETTINGS" Foreground="#94A3B8" Margin="10,20,10,5" FontSize="11" FontWeight="Bold"/>

                    <ui:Button Content="Import CSV" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="ImportCsv_Click" Margin="0,0,0,5"/>
                    <ui:Button Content="Backup DB" Icon="{ui:SymbolIcon Database24}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="BackupDb_Click" Margin="0,0,0,5"/>
                    <ui:Button Content="Restore DB" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="RestoreDb_Click" Margin="0,0,0,5"/>
                    <ui:Button Content="Auto-Start" Icon="{ui:SymbolIcon Rocket24}" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AutoStart_Click" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1" Margin="20">

                <!-- TASKS PAGE -->
                <Grid x:Name="TasksPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,20,0"/>
                        <ui:Button Content="➕ New Client" Click="AddClient_Click" Appearance="Primary" Margin="0,0,10,0"/>
                        <ui:Button Content="📝 Create Task" Click="AddTask_Click" Margin="0,0,20,0"/>

                        <ui:TextBox x:Name="TaskSearchBox" Width="200" PlaceholderText="Search tasks..." TextChanged="TaskSearchBox_TextChanged" Margin="0,0,15,0"/>
                        <CheckBox x:Name="ShowCompletedCheck" Content="Show Completed" VerticalAlignment="Center"
                                  Checked="ShowCompletedCheck_Changed" Unchecked="ShowCompletedCheck_Changed"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="TaskGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📞 Copy Phone" Click="CopyPhone_Click"/>
                                <MenuItem Header="⏰ Snooze 15 Minutes" Click="Snooze15_Click"/>
                                <MenuItem Header="⏰ Snooze 1 Hour" Click="Snooze1H_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="130"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding Client.Name}" Width="150"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Client.Phone}" Width="120"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat='MMM dd, hh:mm tt'}" Width="130"/>
                            <DataGridTextColumn Header="Time Left" Binding="{Binding TimeLeft}" Width="100"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>

                            <DataGridTemplateColumn Header="Action" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Tag="{Binding}" PreviewMouseLeftButtonDown="CompleteTask_Click" Content="✅" Background="#22C55E" Foreground="White" BorderThickness="0" Padding="6" Margin="0,0,5,0"/>
                                            <ui:Button Tag="{Binding}" Content="✏️" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="6" Margin="0,0,5,0" PreviewMouseLeftButtonDown="EditTask_Click"/>
                                            <ui:Button Tag="{Binding}" Content="🗑️" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="6" PreviewMouseLeftButtonDown="DeleteTask_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- CLIENTS PAGE -->
                <Grid x:Name="ClientsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <ui:TextBox x:Name="ClientSearchBox" Width="250" PlaceholderText="Search clients..." TextChanged="ClientSearchBox_TextChanged" Margin="0,0,20,0"/>
                        <TextBlock x:Name="ClientCountText" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A78BFA"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="ClientGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              MouseDoubleClick="ClientGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>

                            <DataGridTemplateColumn Header="Action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Tag="{Binding}" Content="📞" Background="#22C55E" Foreground="White" BorderThickness="0" Padding="6" Margin="0,0,5,0" PreviewMouseLeftButtonDown="CallClient_Click"/>
                                            <ui:Button Tag="{Binding}" Content="✉️" Background="#F59E0B" Foreground="White" BorderThickness="0" Padding="6" Margin="0,0,5,0" PreviewMouseLeftButtonDown="EmailClient_Click"/>
                                            <ui:Button Tag="{Binding}" Content="✏️" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="6" Margin="0,0,5,0" PreviewMouseLeftButtonDown="EditClient_Click"/>
                                            <ui:Button Tag="{Binding}" Content="🗑️" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="6" PreviewMouseLeftButtonDown="DeleteClient_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>